<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Apple TV aerials: Apple's certificate comes from Apple's own root, which Android doesn't trust. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">sylvan.apple.com</domain>
    </domain-config>
</network-security-config>
